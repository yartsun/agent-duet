#!/usr/bin/env python3
"""Stand-in for `claude -p` used by examples/demo.py: reviews (or edits) and prints a JSON envelope."""
import json
import re
import sys
from pathlib import Path

argv = sys.argv[1:]
prompt = sys.stdin.read()
spec = json.loads(re.search(r'\nTask:\n(\{.*?\})\n', prompt + '\n').group(1))
changed = []
if 'Edit' in argv[argv.index('--tools') + 1]:
    target = next((p for p in spec['allowed_paths'] if not set(p) & set('*?[')), 'NOTES.md')
    path = Path.cwd() / target
    path.write_text((path.read_text() if path.exists() else '') + '- ' + spec['title'] + '\n')
    changed = [target]
result = {'status': 'ok', 'summary': ('Updated ' + ', '.join(changed)) if changed else 'Reviewed the diff: it matches the goal',
          'changed_files': changed, 'risks': [], 'requests': []}
print(json.dumps({'is_error': False, 'structured_output': result, 'total_cost_usd': 0.0123,
                  'usage': {'input_tokens': 2100, 'output_tokens': 640, 'cache_read_input_tokens': 9800,
                            'cache_creation_input_tokens': 1200}}))
