#!/usr/bin/env python3
"""Stand-in for `codex exec` used by examples/demo.py: edits the first allowed file and reports usage."""
import json
import re
import sys
from pathlib import Path

argv = sys.argv[1:]
prompt = sys.stdin.read()
spec = json.loads(re.search(r'\nTask:\n(\{.*?\})\n', prompt + '\n').group(1))
changed = []
if argv[argv.index('--sandbox') + 1] == 'workspace-write':
    target = next((p for p in spec['allowed_paths'] if not set(p) & set('*?[')), 'NOTES.md')
    path = Path(argv[argv.index('--cd') + 1]) / target
    path.write_text((path.read_text() if path.exists() else '') + '- ' + spec['title'] + '\n')
    changed = [target]
result = {'status': 'ok', 'summary': ('Updated ' + ', '.join(changed)) if changed else 'Reviewed the diff: it matches the goal',
          'changed_files': changed, 'risks': [], 'requests': []}
Path(argv[argv.index('--output-last-message') + 1]).write_text(json.dumps(result))
print(json.dumps({'type': 'turn.completed', 'usage': {'input_tokens': 18400, 'output_tokens': 950, 'cached_input_tokens': 12000}}))
